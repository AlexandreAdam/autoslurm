{
  "type": "object",
  "patternProperties": {
    "^.+$": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "script": {"type": "string"},
        "script_args": {"type": "object"},
        "path_args": {"type": "array", "items": {"type": "string"}},
        "input_args": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string"},
        "environment": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "runtime_environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "software": {
          "description": "Optional shared source request on every job. Managed runtime execution is not yet available.",
          "type": "object",
          "properties": {
            "version": {"type": "integer", "enum": [1]},
            "runtime": {"type": "string"},
            "projects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "repository": {"type": "string"},
                  "revision": {"type": ["string", "null"]},
                  "subdirectory": {"type": "string"}
                },
                "required": ["name", "repository"],
                "additionalProperties": false
              }
            }
          },
          "required": ["projects"],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string"}
        },
        "pre_commands": {
          "type": "array",
          "items": {"type": "string"}
        },
        "slurm": {
          "type": "object",
          "properties": {
            "time": {"type": "string"},
            "cpus_per_task": {"type": "integer"},
            "gres": {"type": "string"},
            "mem": {"type": "string"},
            "tasks": {"type": "integer"},
            "array": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "required": ["name", "script", "slurm"]
    }
  },
  "additionalProperties": false
}
